.meas TRAN i2_A FIND I(R1) AT=1
.meas TRAN i3_A FIND I(R2) AT=1
.meas TRAN Ix_A FIND I(R5) AT=1
.meas TRAN Iy_A FIND I(R1) AT=1
.end
